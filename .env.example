GEMINI_API_KEY=
PORT=3000

# Leave empty to auto-pick the newest model your key supports.
# "npm run models" lists them · "npm run bench" finds the fastest.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=9000

# ---------------------------------------------------------------- voices ---
# edge-tts voices — "npm run voices" generates samples to compare
SAKEENAH_VOICE_EN=en-US-AvaMultilingualNeural
SAKEENAH_VOICE_AR=ar-SA-ZariyahNeural

# ------------------------------------------------------------- behaviour ---
# Auto-fire timers for the scripted simulation. 0 = off, which is what you want
# for a recording: real medication times and real GPS run untouched, and you fire
# each feature yourself from the Demo triggers panel.
DRIFT_AFTER_SECONDS=0
DEMO_MED_AFTER_SECONDS=0

# Keep the demo alive if Gemini is rate-limited or down (shows a visible banner)
FALLBACK_BRAIN=1
PROACTIVE_COOLDOWN_MS=6000
